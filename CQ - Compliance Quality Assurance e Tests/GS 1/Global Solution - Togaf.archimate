  <folder name="Business" id="id-ca4436b99a7e4d0e98142c818fa18795" type="business">
    <element xsi:type="archimate:BusinessActor" name="Business Actor 1 - Administrador do Hotel Espacial" id="id-cd5b9f6824974f0fb48d9481034931bf">
      <documentation>Responsável pelo gerenciamento geral do habitat.</documentation>
    </element>
