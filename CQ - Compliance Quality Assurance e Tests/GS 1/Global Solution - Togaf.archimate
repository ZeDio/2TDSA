      <documentation>Usuário que realiza reservas e acompanha informações do habitat.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Business Role 1 - Gerente do Habitat" id="id-c27c43e37c5f4888b457ff9f02a69111">
      <documentation>Responsável pelo monitoramento e controle do hotel.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Business Role 2 - Ocupante do Habitat" id="id-e8ba61d39c474fc586a74281d6222ce8">
      <documentation>Responsável por utilizar os módulos/quartos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Business Service 1 - Serviço de Monitoramento Ambiental" id="id-55a7043c9f4d479d9691917e58b5e3a0">
      <documentation>Responsável por exibir:&#xD;
temperatura,&#xD;
oxigênio,&#xD;
radiação.</documentation>
    </element>
