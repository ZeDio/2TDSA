  <folder name="Motivation" id="id-1ff81d239e65459e82e2d253c9c0bbb0" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Stakeholder 1 - Operadora do Hotel Espacial" id="id-5a2249de6f49411c87f1191f0ea1ad24">
      <documentation>Representa a empresa responsável pelo gerenciamento do hotel/habitat.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Stakeholder 2 - Hóspedes e Astronautas" id="id-69244a30adbf4ca49ee2ddb04766bbbc">
      <documentation>Usuários que utilizarão os habitats espaciais.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Driver 1 - Necessidade de monitoramento ambiental" id="id-0667fe2c7f5e45ebb115762b8060b374">
      <documentation>Motiva o controle constante de:&#xD;
oxigênio,&#xD;
temperatura,&#xD;
radiação.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Driver 2 - Segurança dos ocupantes" id="id-2db5c5b0b42c4da69f11482927675077">
      <documentation>Necessidade de prevenir falhas críticas no habitat.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Driver 3 - " id="id-afcf2ee1b5154c6197de0ef917ba99b1">
      <documentation>Motiva o controle constante de:&#xD;
oxigênio,&#xD;
temperatura,&#xD;
radiação.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Goal 1 - Garantir segurança dos hóspedes e astronautas" id="id-d4ba9ad90064457eb3c8d925d1e52a70">
      <documentation>Garantir segurança dos hóspedes e astronautas</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Goal 2 - Monitorar o habitat em tempo real" id="id-35a7266c15a844a8b457a7a2c8568bfd">
      <documentation>Monitorar o habitat em tempo real</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Goal 2 - Monitorar o habitat em tempo real (copy)" id="id-213931b2b1c1456cafb7a9728ef2c264">
      <documentation>Monitorar o habitat em tempo real</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Principle 1 - Monitoramento contínuo" id="id-fb58323e177a4b0eaa3e4589f95a15ef">
      <documentation>Os sensores devem funcionar continuamente.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Principle 2 - Disponibilidade do sistema" id="id-3775fdb802d04f5baa4f8a80da3a8e0c">
      <documentation>O sistema deve permanecer acessível em tempo integral.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Requirement 1 - Dashboard em tempo real" id="id-5052b4aa98324de7bce9513bc3d18d84">
      <documentation>Dashboard em tempo real</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Requirement 2 - Sistema de alertas automáticos" id="id-9c4cccaf28964052b743ecfc61202418">
      <documentation>Sistema de alertas automáticos</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Requirement 2 - Comunicação com ESP32" id="id-05d8610a55dd4e08a61d6a2bad549412">
      <documentation>Comunicação com ESP32</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Requirement 3 - Controle de reservas" id="id-47d92401262d4cad9ba7c65b2dfe2483">
      <documentation>Controle de reservas</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Requirement 4 - Armazenamento de dados dos sensores" id="id-f0ba06dae37a403eafee61049d1a9392">
      <documentation>Armazenamento de dados dos sensores</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Constraint 2 - Uso de MVP simplificado" id="id-f3b35ccf623e44ccbc4008ffa85d25bd">
      <documentation>A primeira versão terá funcionalidades reduzidas.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Constraint 2 - Sensores parcialmente simulados" id="id-2d32897ff23a4d3ab9678d9c6be6cb20">
      <documentation>Parte dos dados ambientais será simulada.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Assessment 1 - Ambientes espaciais possuem alto risco operacional" id="id-94cdd50429c24c14bf683f943879cc6c">
      <documentation>Falhas ambientais podem comprometer sobrevivência e funcionamento do habitat.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Assessment 2 - Monitoramento manual é ineficiente" id="id-57987de9df0d42b5b93dac14d8774b3f">
      <documentation>Sem automação, há maior risco de erros e atrasos na resposta.</documentation>
    </element>
  </folder>
