    <element xsi:type="archimate:BusinessService" name="Business Service 2 - Serviço de Reservas (copy) (copy)" id="id-43ede53a05e34beabff8cd0132e37511">
      <documentation>Gerencia reservas de módulos/quartos.</documentation>
    </element>
